# Dependencies
/node_modules/
/.pnp
.pnp.*

# Next.js builds and caches
/.next/
/out/
/build/
/dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Environment files hold secrets: never commit them. Each environment keeps
# its own; .env.example documents every variable.
.env*
!.env.example

# Keys and certificates
*.pem
*.key
*.p12
*.pfx

# Database dumps hold customer data. The schema migrations in drizzle/ are
# the only SQL that belongs in the repository.
*.sql
*.sql.gz
*.dump
!/drizzle/*.sql

# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Tests and tooling caches
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.eslintcache

# Deployment
.vercel/

# Operating systems
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
/tmp/
/temp/
