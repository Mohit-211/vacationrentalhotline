# Copy to .env.local (development) or set in the server's environment.
# Server-only values are validated the first time the server needs them.

# Public URL of the site, without a trailing slash. Links in emails use it.
APP_URL=http://localhost:3000

# MySQL 8.0 database. Create it with:
#   CREATE DATABASE vrh CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
# then run `npm run db:migrate`.
DATABASE_URL=mysql://vrh:password@127.0.0.1:3306/vrh

# Signs sessions and email links. At least 32 random characters, e.g.
#   openssl rand -base64 32
# Changing it signs everyone out and invalidates links already sent.
BETTER_AUTH_SECRET=

# Outgoing email. "smtp" sends through the server below; "log" prints each
# email to the server console instead. Defaults: "log" in development,
# "smtp" in production.
MAIL_TRANSPORT=log
SMTP_HOST=
# 587 (STARTTLS) or 465 (TLS)
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Vacation Rental Hotline <no-reply@vacationrentalhotline.com>"

# Gets a copy of staff notices, such as a customer's cover ending.
STAFF_EMAIL=info@vacationrentalhotline.com

# Stripe. The publishable key is used by the checkout form in the browser;
# the secret key by the server. Use the sk_test_/pk_test_ pair outside production.
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of the webhook endpoint https://<site>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Scheduled jobs (removing unverified accounts, cover-ended emails, clean-up)
# run inside the app every 15 minutes; "off" stops this process running them.
SCHEDULED_JOBS=on
# Optional: lets POST /api/jobs/run (Authorization: Bearer <secret>) run them
# on demand. At least 32 characters; leave empty to turn that off.
JOBS_SECRET=
