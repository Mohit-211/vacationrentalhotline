# Copy to .env.local (development) or set in the server's environment.
# Server-only values are validated the first time the server needs them.

# Public URL of the site, without a trailing slash. Links in emails use it.
APP_URL=http://localhost:3000

# MySQL 8.0 database. Create it with:
#   CREATE DATABASE vrh CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
# then run `npm run db:migrate`.
DATABASE_URL=mysql://vrh:password@127.0.0.1:3306/vrh

# Signs sessions and email links. At least 32 random characters, e.g.
#   openssl rand -base64 32
# Changing it signs everyone out and invalidates links already sent.
BETTER_AUTH_SECRET=

# Outgoing email. "smtp" sends through the server below; "log" prints each
# email to the server console instead. Defaults: "log" in development,
# "smtp" in production.
MAIL_TRANSPORT=log
SMTP_HOST=
# 587 (STARTTLS) or 465 (TLS)
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Vacation Rental Hotline <no-reply@vacationrentalhotline.com>"

# Stripe publishable key, used by the checkout form in the browser.
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
